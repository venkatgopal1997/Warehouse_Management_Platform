# Database - Cloud SQL PostgreSQL (production)
# Replace PROJECT_ID, REGION, INSTANCE_NAME, user, password with your values
DATABASE_URL="postgresql://app_user:AppUserPass456!@/warehouse_app?host=/cloudsql/YOUR_PROJECT_ID:asia-south1:warehouse-db"

# BigQuery
GOOGLE_CLOUD_PROJECT="your-gcp-project-id"
BIGQUERY_DATASET="warehouse_analytics"
GOOGLE_APPLICATION_CREDENTIALS="./service-account.json"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"