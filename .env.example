# Database - use SQLite for local dev, Cloud SQL Postgres for production
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://user:password@/dbname?host=/cloudsql/PROJECT_ID:REGION:INSTANCE_NAME"

# WorkOS AuthKit
WORKOS_API_KEY="sk_test_..."
WORKOS_CLIENT_ID="client_..."
WORKOS_REDIRECT_URI="http://localhost:3000/api/auth/callback"
WORKOS_COOKIE_PASSWORD="a-random-32-character-string-here-min"

# BigQuery
GOOGLE_CLOUD_PROJECT="your-gcp-project-id"
BIGQUERY_DATASET="warehouse_analytics"
GOOGLE_APPLICATION_CREDENTIALS="./service-account.json"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"